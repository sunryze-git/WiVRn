#: dashboard/qml/TroubleshootPage.qml:20
#, kde-format
msgid "I cannot find the Wyrm app on my headset"
msgstr "Qulaqlığımda Wyrm tətbiqini tapa bilmirəm"

#: dashboard/qml/TroubleshootPage.qml:21 dashboard/qml/WizardPage.qml:344
#, kde-format
msgid ""
"If you installed Wyrm over USB on a Meta or Pico headset, the app is in the "
"\"unknown sources\" section."
msgstr ""
"Wyrm-i Meta və ya Pico qulaqlığına USB ilə quraşdırmısınızsa, tətbiq "
"\"naməlum mənbələr\" bölməsindədir."

#: dashboard/qml/TroubleshootPage.qml:24
#, kde-format
msgid "I cannot see my computer in the Wyrm app"
msgstr "Wyrm tətbiqində kompüterimi görə bilmirəm"

#: dashboard/qml/TroubleshootPage.qml:25
#, kde-format
msgid "If you have a firewall, make sure that port 5353/UDP is open."
msgstr ""
"Təhlükəsizlik divarınız varsa, 5353/UDP portunun açıq olduğuna əmin olun."

