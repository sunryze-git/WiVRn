#: dashboard/qml/TroubleshootPage.qml:36
#, kde-format
msgid "I have an \"Incompatible Wyrm server\" error on my headset"
msgstr "Zobrazila sa chyba „Verzia servera nie je kompatibilná“ na headsete"

#: dashboard/qml/TroubleshootPage.qml:37
#, kde-format
msgid ""
"<p>The version of the headset app and the server on your computer must match."
"</p><ul><li>The headset app version is in the \"About\" page</li><li>The "
"server version is <b>%1</b></li></ul>"
msgstr ""
"<p>Verzia aplikácie v headsete a verzia servera na vašom počítači sa musia "
"zhodovať.</p><ul><li>Verziu aplikácie nájdete v časti „O aplikácii“</"
"li><li>Verzia servera je <b>%1</b></li></ul>"

#: dashboard/qml/TroubleshootPage.qml:40
#, kde-format
msgid "I have a \"Pairing is disabled\" error"
msgstr "Zobrazila sa chyba „Párovanie je na serveri vypnuté“"

#: dashboard/qml/TroubleshootPage.qml:41
#, kde-format
msgid ""
"If you have reinstalled the server or the client or if you want to connect "
"another headset, you must enable pairing before connecting."
msgstr ""
"Ak ste preinštalovali server alebo klienta, alebo ak chcete pripojiť iný "
"headset, musíte pred pripojením zapnúť párovanie."

#: dashboard/qml/TroubleshootPage.qml:41
#, kde-format
msgid "Pairing is currently enabled with PIN %1."
msgstr "Párovanie je momentálne zapnuté, PIN: %1."

#: dashboard/qml/TroubleshootPage.qml:41
#, kde-format
msgid "Pairing is currently disabled."
msgstr "Párovanie je momentálne vypnuté."

#: dashboard/qml/TroubleshootPage.qml:57
#, kde-format
msgid "I have no sound on my headset"
msgstr "V headsete nemám zvuk"

#: dashboard/qml/TroubleshootPage.qml:58 dashboard/qml/WizardPage.qml:397
#, kde-format
msgid ""
"When the headset is connected, select \"Wyrm\" as the default audio output "
"device for applications to use it."
msgstr ""
"Keď je headset pripojený, vyberte „Wyrm“ ako predvolené zvukové zariadenie, "
"aby ho aplikácie používali."

#: dashboard/qml/TroubleshootPage.qml:61
#, kde-format
msgid "Some games fail to start or have input issues"
msgstr "Niektoré hry sa nespustia alebo majú problémy s ovládaním"

#: dashboard/qml/TroubleshootPage.qml:62
#, kde-format
msgid ""
"For game specific issues, check on <a href=\"https://db.vronlinux.org/"
"\">vronlinux DB</a> if there are known bugs or workarounds."
msgstr ""
"Pri problémoch konkrétnych hier skontrolujte <a href=\"https://"
"db.vronlinux.org/\">vronlinux databázu</a> , či neexistujú známe chyby alebo "
"riešenia."

#: dashboard/qml/TroubleshootPage.qml:79
#, kde-format
msgid "Report an issue"
msgstr "Nahlásiť problém"

#: dashboard/qml/TroubleshootPage.qml:85
#, kde-format
msgid "Ask on Discord"
msgstr "Opýtať sa na Discorde"

