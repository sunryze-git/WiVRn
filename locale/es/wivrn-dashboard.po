msgstr "Habilitar ventana de depuración"

#: dashboard/qml/SettingsPage.qml:151
#, kde-format
msgid "Enable SteamVR tracked devices support"
msgstr "Habilitar soporte para dispositivos de seguimiento a través de SteamVR"

#: dashboard/qml/SettingsPage.qml:154
#, kde-format
msgid ""
"Allows the use of lighthouse-based controllers and trackers.\n"
"Requires SteamVR to be installed.\n"
"Devices must be be powered on before connecting to Wyrm.\n"
"An external tool such as motoc is needed for calibration."
msgstr ""
"Permite el uso de controles y dispositivos de seguimiento basados en "
"estaciones base.\n"
"Es necesario tener SteamVR instalado.\n"
"Los dispositivos deben de estar encendidos antes de conectarte a Wyrm.\n"
"Una herramienta externa como motoc será necesaria para la calibración."

#: dashboard/qml/SettingsPage.qml:160
#, kde-format
msgid "Clamp extrapolation for SteamVR tracked devices"
msgstr "Limitar extrapolación para dispositivos seguidos por SteamVR"

#: dashboard/qml/SettingsPage.qml:164
#, kde-format
