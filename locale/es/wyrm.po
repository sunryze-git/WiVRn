#: client/scenes/gui_settings.cpp:233
msgid "Refresh rate"
msgstr "Frecuencia de actualización"

#: client/scenes/gui_settings.cpp:235
msgid ""
"Wyrm can't directly change the refresh rate on this device. See your "
"device's settings to change the refresh rate."
msgstr ""
"Wyrm no puede cambiar directamente la tasa de refresco en este dispositivo. "
"Vea los ajustes del dispositivo para cambiar la tasa de refresco."

#: client/scenes/gui_settings.cpp:236
msgid ""
"Use 'auto' to select the refresh rate based on measured application "
"performance. May cause flicker when a change happens."
msgstr ""
"Elija 'auto' para seleccionar la frecuencia de refresco en base al "
"rendimiento medido de la aplicacion. Podría causar parpadeos cuando ocurre "
"un cambio."

#: client/scenes/gui_settings.cpp:259
msgctxt "automatic refresh rate, use a short string"
msgid "Auto"
msgstr "Auto"

#: client/scenes/gui_settings.cpp:273
msgid "Render resolution"
msgstr "Resolución de renderizado"

#: client/scenes/gui_settings.cpp:274
#, c++-format
msgctxt "render resolution"
msgid "Pixels rendered per eye ({}x{}). Lower to gain performance."
msgstr "Pixeles renderizados por ojo ({}x{}). Reducir para ganar rendimiento."

#: client/scenes/gui_settings.cpp:289
msgid "Application SpaceWarp"
msgstr "SpaceWarp de aplicación"

#: client/scenes/gui_settings.cpp:290
msgid "Renders at half the refresh rate. The headset may synthesise frames."
msgstr ""
"Renderiza a la mitad de la frecuencia de refresco. El visor podría "
"estrapolar fotogramas."

#: client/scenes/gui_settings.cpp:296
msgid "Set a refresh rate other than auto to enable this setting."
msgstr ""
"Seleccione una frecuencia de refresco distinta a auto para habilitar este "
"ajuste."

#: client/scenes/gui_settings.cpp:300
msgctxt "page header title"
msgid "Video"
msgstr "Vídeo"

#: client/scenes/gui_settings.cpp:300
msgctxt "page header subtitle"
msgid "Frame rate and resolution."
msgstr "Frecuencia de refresco y resolución."

#: client/scenes/gui_settings.cpp:312
msgid "Foveated encoding"
msgstr "Codificación foveada"

#: client/scenes/gui_settings.cpp:314
msgid ""
"Higher values focus image quality where you look at, improving latency, "
"power efficiency and quality."
msgstr ""
"Un mayor valor hará que la calidad de la imagen se centre a donde tú mires, "
"mejorando la latencia, eficiencia energética y calidad."

#: client/scenes/gui_settings.cpp:315
msgid ""
"Higher values focus image quality at the center, improving latency, power "
"efficiency and quality."
msgstr ""
"Un mayor valor hará que la calidad de la imagen se centre en el centro, "
"mejorando la latencia, eficiencia energética y calidad."

#: client/scenes/gui_settings.cpp:331 client/scenes/gui_settings.cpp:343
msgctxt "Codec"
msgid "Automatic"
msgstr "Automático"

#: client/scenes/gui_settings.cpp:335
msgctxt "Codec"
msgid "H.264"
msgstr "H.264"

#: client/scenes/gui_settings.cpp:337
msgctxt "Codec"
msgid "HEVC (H.265)"
msgstr "HEVC (H.265)"

#: client/scenes/gui_settings.cpp:339
msgctxt "Codec"
msgid "AV1"
msgstr "AV1"

#: client/scenes/gui_settings.cpp:353 client/scenes/gui_settings.cpp:366
msgctxt "setting name"
msgid "Video codec"
msgstr "Códec de Vídeo"

#: client/scenes/gui_settings.cpp:354
msgid "How video is compressed before it is sent to the headset."
msgstr "Como se comprime el vídeo antes de ser enviado al visor."

#: client/scenes/gui_settings.cpp:374
msgctxt "setting name"
msgid "10-bit color"
msgstr "color 10-bit"

#: client/scenes/gui_settings.cpp:375
msgid "Higher color precision, supported by HEVC and AV1."
msgstr "Mayor precisión de color, soportado por HEVC y AV1."

#: client/scenes/gui_settings.cpp:386
msgid "Bitrate"
msgstr "Bitrate"

#: client/scenes/gui_settings.cpp:387
msgid "Video data rate sent to the headset."
msgstr "Cantidad de datos de vídeo enviados al visor."

#: client/scenes/gui_settings.cpp:402
msgctxt "setting name"
msgid "Foveation center override"
msgstr "Reajustar el centro de la fóvea"

#: client/scenes/gui_settings.cpp:403
msgid ""
"Manually set where image quality is focused, instead of the center or your "
"gaze."
msgstr ""
"Poner manualmente en donde se concentra la calidad de imagen, en vez de en "
"el centro o tu mirada."

#: client/scenes/gui_settings.cpp:415
msgctxt "setting name"
msgid "Foveation center"
msgstr "Centro de la fóvea"

#: client/scenes/gui_settings.cpp:416
#, c++-format
msgid "Height {:.1f} °, distance {:.2f} m"
msgstr "Altura {:.1f} °, distancia {:.2f} m"

#: client/scenes/gui_settings.cpp:418
msgctxt "button label to change the foveation center"
msgid "Change"
msgstr "Cambiar"

#: client/scenes/gui_settings.cpp:421
msgid "Enable foveation center override to change this setting."
msgstr "Habilite reajustar el centro de la fóvea para cambiar este ajuste."

#: client/scenes/gui_settings.cpp:425
msgctxt "page header title"
msgid "Streaming"
msgstr "Transmitiendo"

#: client/scenes/gui_settings.cpp:425
msgctxt "page header subtitle"
msgid "How video is encoded and sent to the headset."
msgstr "Como es codificado y enviado el vídeo al visor."

#: client/scenes/gui_settings.cpp:430
msgctxt "confirmation messagebox title"
msgid "Disable in-stream window"
msgstr "Deshabilitar ventana mientras se juega"

#: client/scenes/gui_settings.cpp:431
msgctxt "confirmation message"
msgid ""
"Do you really want to disable the in-stream window?\n"
"You will not be able to re-open it with the thumbsticks."
msgstr ""
"Realmente quiere deshabilitar la ventana mientras se juega?\n"
"No podrá volverla a abrir con los joysticks."

#: client/scenes/gui_settings.cpp:432 client/scenes/lobby_gui.cpp:886
msgid "Yes"
msgstr "Sí"

#: client/scenes/gui_settings.cpp:433 client/scenes/lobby_gui.cpp:893
msgid "No"
msgstr "No"

#: client/scenes/gui_settings.cpp:454
msgctxt "openxr_post_processing"
msgid "Normal"
msgstr "Normal"

#: client/scenes/gui_settings.cpp:457
msgctxt "openxr_post_processing"
msgid "Quality"
msgstr "Calidad"

#: client/scenes/gui_settings.cpp:459
msgctxt "openxr_post_processing"
msgid "Disabled"
msgstr "Deshabilitado"

#: client/scenes/gui_settings.cpp:484
msgid "Supersampling"
msgstr "Sobremuestreo"

#: client/scenes/gui_settings.cpp:484
msgid ""
"Reduce flicker for high contrast edges. Useful when the input resolution is "
"high compared to the headset display."
msgstr ""
"Reduce el parpadeo para los bordes de alto contraste. Útil cuando la "
"resolución de entrada es mayor en comparación con la del visor."

#: client/scenes/gui_settings.cpp:485
msgid "Sharpening"
msgstr "Nitidez"

#: client/scenes/gui_settings.cpp:485
msgid ""
"Improve clarity of high contrast edges and counteract blur. Useful when the "
"input resolution is low compared to the headset display."
msgstr ""
"Mejora la claridad de los bordes de alto contraste y contrarresta el blur. "
"Útil cuando la resolución de entrada es menor en comparación con la del "
"visor."

#: client/scenes/gui_settings.cpp:488
msgid "Post-processing"
msgstr "Post-procesamiento"

#: client/scenes/gui_settings.cpp:488
msgctxt "page header subtitle"
msgid "OpenXR layer supersampling and sharpening."
msgstr "Capa OpenXR de supermuestreo y nitidez."

#: client/scenes/gui_settings.cpp:496 client/scenes/gui_settings.cpp:578
msgctxt "tooltip for disabled settings"
msgid "Disconnect to change this setting."
msgstr "Desconectese para cambiar este ajuste."

#: client/scenes/gui_settings.cpp:501
msgctxt "setting name"
msgid "Microphone"
msgstr "Micrófono"

#: client/scenes/gui_settings.cpp:502
msgid "Stream the headset microphone to the PC."
msgstr "Transmitir el micrófono del visor al PC."

#: client/scenes/gui_settings.cpp:514
msgctxt "setting name"
msgid "Unprocessed audio"
msgstr "Entrada de audio sin procesar"

#: client/scenes/gui_settings.cpp:515
msgid "Disable audio filters, such as noise cancellation."
msgstr "Deshabilita filtros de audio, asi como la cancelación de ruido."

#: client/scenes/gui_settings.cpp:525
msgctxt "page header title"
msgid "Audio"
msgstr "Audio"

#: client/scenes/gui_settings.cpp:525
msgctxt "page header subtitle"
msgid "Microphone streamed to the PC."
msgstr "Micrófono transmitido al PC."

#: client/scenes/gui_settings.cpp:538
msgctxt "setting name"
msgid "Keyboard"
msgstr "Teclado"

#: client/scenes/gui_settings.cpp:539
msgid "Forward the keyboard from the headset to the PC."
msgstr "Redireccionar el teclado del visor al PC."

#: client/scenes/gui_settings.cpp:548
msgctxt "setting name"
msgid "Mouse"
msgstr "Ratón"

#: client/scenes/gui_settings.cpp:549
msgid "Forward the mouse from the headset to the PC."
msgstr "Redireccionar el ratón del visor al PC."

#: client/scenes/gui_settings.cpp:559
msgctxt "setting name"
msgid "Gamepad"
msgstr "Gamepad"

#: client/scenes/gui_settings.cpp:560
msgid "Forward the gamepad from the headset to the PC."
msgstr "Redireccionar el gamepad del visor al PC."

#: client/scenes/gui_settings.cpp:567
msgctxt "page header title"
msgid "Devices"
msgstr "Dispositivos"

#: client/scenes/gui_settings.cpp:567
msgctxt "page header subtitle"
msgid "Forward input devices to the PC."
msgstr "Redireccionar dispositivos de entrada al PC."

#: client/scenes/gui_settings.cpp:571 client/scenes/stream_network.cpp:99
msgid "The server does not allow forwarded input devices"
msgstr "El servidor no permite redireccionar dispositivos de entrada"

#: client/scenes/gui_settings.cpp:587
msgctxt "setting name"
msgid "Posture"
msgstr "Postura"

#: client/scenes/gui_settings.cpp:588
msgid "Posture assumed when a stream connects."
msgstr "Postura que se tendrá al conectarse a la transmisión."

#: client/scenes/gui_settings.cpp:592
msgctxt "posture"
msgid "Standing"
msgstr "De pie"

#: client/scenes/gui_settings.cpp:592
msgctxt "posture"
msgid "Seated"
msgstr "Sentado"

#: client/scenes/gui_settings.cpp:598
msgctxt "setting name"
msgid "Height adjustment"
msgstr "Ajuste de altura"

#: client/scenes/gui_settings.cpp:600
msgid ""
"Corrects the height reported to the PC when seated, useful for games without "
"native seated support."
msgstr ""
"Corrige la altura que se envia al PC cuando se está sentado, util para "
"juegos sin soporte nativo para estar sentado."

#: client/scenes/gui_settings.cpp:601
msgid ""
"Corrects the height reported to the PC when standing, useful for a "
"miscalibrated floor."
msgstr ""
"Corrige la altura que se envia al PC cuando se está de pie, util cuando el "
"suelo está sin calibrar."

#: client/scenes/gui_settings.cpp:626
msgctxt "setting name"
msgid "Hand tracking"
msgstr "Seguimiento de manos"

#: client/scenes/gui_settings.cpp:626
msgid "Track your hands for input when controllers are down."
msgstr "Seguir tus manos para entrada cuando los controles no se usen."

#: client/scenes/gui_settings.cpp:629
msgctxt "setting name"
msgid "Eye tracking"
msgstr "Seguimiento ocular"

#: client/scenes/gui_settings.cpp:629
msgid "Used by foveated encoding to focus quality where you look."
msgstr ""
"Usado por el renderizado foveado para concentrar la calidad en donde miras."

#: client/scenes/gui_settings.cpp:632
msgctxt "setting name"
msgid "Face tracking"
msgstr "Seguimiento facial"

#: client/scenes/gui_settings.cpp:632
msgid "Stream facial expressions to the PC."
msgstr "Transmitir expresiones faciales al PC."

#: client/scenes/gui_settings.cpp:640
msgctxt "virtual body tracker selection"
msgid "Chest"
msgstr "Pecho"

#: client/scenes/gui_settings.cpp:641
msgctxt "virtual body tracker selection"
msgid "Left elbow"
msgstr "Codo izquierdo"

#: client/scenes/gui_settings.cpp:642
msgctxt "virtual body tracker selection"
msgid "Right elbow"
msgstr "Codo derecho"

#: client/scenes/gui_settings.cpp:643
msgctxt "virtual body tracker selection"
msgid "Hip"
msgstr "Cadera"

#: client/scenes/gui_settings.cpp:644
msgctxt "virtual body tracker selection"
msgid "Left knee"
msgstr "Rodilla izquierda"

#: client/scenes/gui_settings.cpp:645
msgctxt "virtual body tracker selection"
msgid "Right knee"
msgstr "Rodilla derecha"

#: client/scenes/gui_settings.cpp:646
msgctxt "virtual body tracker selection"
msgid "Left foot"
msgstr "Pie izquierdo"

#: client/scenes/gui_settings.cpp:647
msgctxt "virtual body tracker selection"
msgid "Right foot"
msgstr "Pie derecho"

#: client/scenes/gui_settings.cpp:662
msgctxt "setting name"
msgid "Body tracking"
msgstr "Seguimiento corporal"

#: client/scenes/gui_settings.cpp:664
msgid ""
"Requires 'Hand and body tracking' to be enabled in the Quest movement "
"tracking settings, otherwise body data will be guessed from controller and "
"headset positions."
msgstr ""
"Requiere habilitar 'Seguimiento de manos y del cuerpo' en los ajustes de "
"movimiento de Quest, si no el seguimiento corporal será medido por la "
"posición de los controles y el visor."

#: client/scenes/gui_settings.cpp:665
msgid "Stream body joint positions to the PC."
msgstr "Transmitir las posiciones de las uniones del cuerpo al PC."

#: client/scenes/gui_settings.cpp:676 client/scenes/gui_settings.cpp:691
msgctxt "setting name"
msgid "Virtual body trackers"
msgstr "Trackers de cuerpo virtuales"

#: client/scenes/gui_settings.cpp:677
msgid "Create virtual tracker devices."
msgstr "Crear dispositivos virtuales de seguimiento."

#: client/scenes/gui_settings.cpp:697
msgctxt "page header title"
msgid "Tracking"
msgstr "Seguimiento"

#: client/scenes/gui_settings.cpp:697
msgctxt "page header subtitle"
msgid "Body and input tracking sent to the PC."
msgstr "Seguimiento de cuerpo y entrada enviados al PC."

#: client/scenes/gui_settings.cpp:711
msgctxt "language selection, replace with the name of the language"
msgid "English"
msgstr "Español"

#: client/scenes/gui_settings.cpp:734 client/scenes/gui_settings.cpp:748
msgid "Language"
msgstr "Idioma"

#: client/scenes/gui_settings.cpp:735
msgctxt "setting name"
msgid "Interface language."
msgstr "Idioma de la interfaz."

#: client/scenes/gui_settings.cpp:744
msgctxt "item in the interface language combobox"
msgid "System language"
msgstr "Idioma del sistema"

#: client/scenes/gui_settings.cpp:756
msgctxt "setting name"
msgid "USB networking"
msgstr "Conectividad USB"

#: client/scenes/gui_settings.cpp:757
msgid ""
"Enables connection by USB without ADB or developer mode.\n"
"Make sure the server allows IPv6 link-local only connections."
msgstr ""
"Permite la conexión por USB sin ADB o modo desarrollador.\n"
"Asegurese de que el servidor permita conexiones locales exclusivamente IPv6."

#: client/scenes/gui_settings.cpp:767
msgctxt "setting name"
msgid "Extended configuration"
msgstr "Configuración extendida"

#: client/scenes/gui_settings.cpp:768
msgid "Allows unsafe configuration values, use at your own risk."
msgstr ""
"Permitir valores de configuración inseguros, usar bajo propia "
"responsabilidad."

#: client/scenes/gui_settings.cpp:779
msgid "High power mode"
msgstr "Modo de alto rendimiento"

#: client/scenes/gui_settings.cpp:780
msgid ""
"Increase power usage to allow higher resolution and refresh rate. Drains "
"battery and runs hot."
msgstr ""
"Aumenta el uso de energía para permitir una mayor resolución y frecuencia de "
"actualización. Drena la batería y se calienta."

#: client/scenes/gui_settings.cpp:792
msgctxt "setting name"
msgid "Enable boundary in passthrough"
msgstr "Habilitar límite en enfoque exterior"

#: client/scenes/gui_settings.cpp:793
msgid ""
"Shows the boundary while passthrough is on. Disable to walk freely outside "
"of it. The boundary is always shown in VR."
msgstr ""
"Muestra el límite cuando se está en enfoque exterior. Deshabilite para andar "
"libremente fuera de él. El límite siempre se muestra en VR."

#: client/scenes/gui_settings.cpp:805
msgctxt "setting name"
msgid "In-stream window"
msgstr "Ventana mientras se juega"

#: client/scenes/gui_settings.cpp:806
msgid ""
"Enables the configuration window to be shown while the game is streaming. If "
"enabled, the window is activated by pressing both thumbsticks."
msgstr ""
"Permite que se muestre la ventana de configuración mientras se transmite el "
"juego. Si está habilitado, la ventana se activa presionando ambos joysticks."

