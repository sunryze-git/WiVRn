{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 25,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
				"CMAKE_BUILD_TYPE": "Debug",
				"WYRM_BUILD_CLIENT": "OFF",
				"WYRM_BUILD_SERVER": "OFF",
				"WYRM_BUILD_SERVER_LIBRARY": "OFF",
				"WYRM_BUILD_DASHBOARD": "OFF",
				"WYRM_BUILD_DISSECTOR": "OFF",
				"WYRM_BUILD_WYRMCTL": "OFF",
				"WYRM_USE_VAAPI": "ON",
				"WYRM_USE_VULKAN_ENCODE": "ON",
				"WYRM_USE_X264": "ON",
				"WYRM_USE_NVENC": "ON",
				"WYRM_USE_SYSTEMD": "ON",
				"WYRM_USE_SYSTEM_BOOST": "ON",
				"WYRM_USE_PIPEWIRE": "ON",
				"WYRM_WERROR": "ON"
			}
		},
		{
			"name": "everything",
			"displayName": "Everything",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-everything",
			"cacheVariables": {
				"WYRM_BUILD_CLIENT": "ON",
				"WYRM_BUILD_SERVER": "ON",
				"WYRM_BUILD_SERVER_LIBRARY": "ON",
				"WYRM_BUILD_WYRMCTL": "ON",
				"WYRM_BUILD_DASHBOARD": "ON",
				"WYRM_BUILD_DISSECTOR": "ON",
				"QT_QML_GENERATE_QMLLS_INI": "ON"
			}
		},
		{
			"name": "client",
			"displayName": "Client only",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-client",
			"cacheVariables": {
				"WYRM_BUILD_CLIENT": "ON"
			}
		},
		{
			"name": "server",
			"displayName": "Server only",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-server",
			"cacheVariables": {
				"WYRM_BUILD_SERVER": "ON",
				"WYRM_BUILD_SERVER_LIBRARY": "ON",
				"WYRM_BUILD_WYRMCTL": "ON"
			}
		},
		{
			"name": "server-tracing",
			"displayName": "Server with Perfetto tracing",
			"inherits": "server",
			"binaryDir": "${sourceDir}/build-server-tracing",
			"cacheVariables": {
				"WYRM_USE_PERFETTO": "ON"
			}
		},
		{
			"name": "server-tracing-monado",
			"displayName": "Server with Perfetto tracing (incl. Monado)",
			"inherits": "server-tracing",
			"binaryDir": "${sourceDir}/build-server-tracing-monado",
			"cacheVariables": {
				"WYRM_TRACE_MONADO": "ON"
			}
		},
		{
			"name": "dashboard",
			"displayName": "Dashboard only",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-dashboard",
			"cacheVariables": {
				"WYRM_BUILD_DASHBOARD": "ON",
				"QT_QML_GENERATE_QMLLS_INI": "ON"
			}
		},
		{
			"name": "dissector",
			"displayName": "Wireshark dissector only",
			"inherits": "base",
			"binaryDir": "${sourceDir}/build-dissector",
			"cacheVariables": {
				"WYRM_BUILD_DISSECTOR": "ON"
			}
		},
		{
			"name": "everything-no-systemd",
			"displayName": "Everything (no systemd)",
			"inherits": "everything",
			"binaryDir": "${sourceDir}/build-no-systemd",
			"cacheVariables": {
				"WYRM_BUILD_WYRMCTL": "OFF",
				"WYRM_USE_SYSTEMD": "OFF"
			}
		},
		{
			"name": "everything-no-system-boost",
			"displayName": "Everything (no system Boost)",
			"inherits": "everything",
			"binaryDir": "${sourceDir}/build-no-system-boost",
			"cacheVariables": {
				"WYRM_USE_SYSTEM_BOOST": "OFF"
			}
		},
		{
			"name": "server-no-systemd",
			"displayName": "Server only (no systemd)",
			"inherits": "server",
			"binaryDir": "${sourceDir}/build-server-no-systemd",
			"cacheVariables": {
				"WYRM_BUILD_WYRMCTL": "OFF",
				"WYRM_USE_SYSTEMD": "OFF"
			}
		},
		{
			"name": "client-no-system-boost",
			"displayName": "Client only (no system Boost)",
			"inherits": "client",
			"binaryDir": "${sourceDir}/build-client-no-system-boost",
			"cacheVariables": {
				"WYRM_USE_SYSTEM_BOOST": "OFF"
			}
		},
		{
			"name": "server-no-system-boost",
			"displayName": "Server only (no system Boost)",
			"inherits": "server",
			"binaryDir": "${sourceDir}/build-server-no-system-boost",
			"cacheVariables": {
				"WYRM_USE_SYSTEM_BOOST": "OFF"
			}
		},
		{
			"name": "dissector-no-system-boost",
			"displayName": "Dissector only (no system Boost)",
			"inherits": "dissector",
			"binaryDir": "${sourceDir}/build-dissector-no-system-boost",
			"cacheVariables": {
				"WYRM_USE_SYSTEM_BOOST": "OFF"
			}
		},
		{
			"name": "frame",
			"generator": "Ninja",
			"cacheVariables": {
				"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
				"CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON",
				"CMAKE_BUILD_TYPE": "Release",
				"WYRM_BUILD_CLIENT": "ON",
				"WYRM_BUILD_SERVER": "OFF",
				"WYRM_BUILD_SERVER_LIBRARY": "OFF",
				"WYRM_BUILD_DASHBOARD": "OFF",
				"WYRM_BUILD_DISSECTOR": "OFF",
				"WYRM_BUILD_WYRMCTL": "OFF",
				"WYRM_USE_PIPEWIRE": "ON",
				"WYRM_USE_V4L2": "ON",
				"WYRM_USE_SYSTEM_BOOST": "OFF",
				"WYRM_USE_SYSTEM_LIBKTX": "OFF",
				"WYRM_USE_SYSTEM_OPENXR": "OFF",
				"WYRM_COMPRESS_GLB": "ON",
				"WYRM_WERROR": "ON"
			}
		}
	],
	"buildPresets": [
		{
		"name": "default",
		"displayName": "Build and install",
		"configurePreset": "everything",
		"targets": "install"
		}
	]
}
