From: sunryze <lometon592@gmail.com>
Subject: [PATCH] d/solarxr: Reset receive state and release sockets on reconnect

Keep failed reconnects retryable without retaining a frame from the old peer.
Hold a channel reference while replacing it and do not publish a replacement
if destruction has already invalidated the connection.

diff --git a/src/xrt/drivers/solarxr/solarxr_ipc_socket.c b/src/xrt/drivers/solarxr/solarxr_ipc_socket.c
--- a/src/xrt/drivers/solarxr/solarxr_ipc_socket.c
+++ b/src/xrt/drivers/solarxr/solarxr_ipc_socket.c
@@ -81,6 +81,8 @@
 	free(state->buffer);
 	state->buffer = NULL;
 	state->buffer_cap = 0;
+	state->head = 0;
+	state->buffer_len = 0;
 }
 
 void
@@ -170,8 +172,10 @@
 	return addr;
 }
 
-bool
-solarxr_ipc_socket_connect(struct solarxr_ipc_socket *const state, const struct sockaddr_un addr)
+static bool
+solarxr_ipc_socket_connect_from(struct solarxr_ipc_socket *const state,
+                               const struct sockaddr_un addr,
+                               xrt_ipc_handle_t previous)
 {
 	xrt_ipc_handle_t ipc_handle = XRT_IPC_HANDLE_INVALID;
 	if (addr.sun_family != AF_UNIX) {
@@ -196,19 +200,27 @@
 	}
 
 	// optimistic allocation to avoid needless reallocs during receive
-	solarxr_ipc_socket_ensure_capacity(state, 0x1000);
-
-	atomic_store(&state->ipc_handle, ipc_handle);
+	if (!solarxr_ipc_socket_ensure_capacity(state, 0x1000)) {
+		goto fail;
+	}
+
+	if (!atomic_compare_exchange_strong(&state->ipc_handle, &previous, ipc_handle)) {
+		goto fail;
+	}
+	state->head = 0;
+	state->buffer_len = 0;
 	return true;
 
 fail:
 	xrt_ipc_handle_close(ipc_handle);
 
-	// The IPC handle is used as a lock guard in `solarxr_ipc_socket_destroy()`, so this is the last place to safely
-	// free the buffer without one
-	solarxr_ipc_socket_free_buffer(state);
-
 	return false;
+}
+
+bool
+solarxr_ipc_socket_connect(struct solarxr_ipc_socket *const state, const struct sockaddr_un addr)
+{
+	return solarxr_ipc_socket_connect_from(state, addr, XRT_IPC_HANDLE_INVALID);
 }
 
 // release reference with `xrt_reference_dec(&state->reference);`
@@ -229,6 +241,29 @@
 	    .log_level = state->log_level,
 	};
 	return true;
+}
+
+bool
+solarxr_ipc_socket_reconnect(struct solarxr_ipc_socket *const state, const struct sockaddr_un addr)
+{
+	struct ipc_message_channel previous;
+	if (!solarxr_ipc_socket_reference_channel(state, &previous)) {
+		return false;
+	}
+
+	const bool connected = solarxr_ipc_socket_connect_from(state, addr, previous.ipc_handle);
+	if (connected) {
+		shutdown(previous.ipc_handle, SHUT_RDWR);
+	}
+	xrt_reference_dec(&state->reference);
+
+	if (connected) {
+		while (atomic_load((volatile _Atomic(int) *)&state->reference.count) != 0) {
+			sched_yield();
+		}
+		ipc_message_channel_close(&previous);
+	}
+	return connected;
 }
 
 bool
diff --git a/src/xrt/drivers/solarxr/solarxr_ipc_socket.h b/src/xrt/drivers/solarxr/solarxr_ipc_socket.h
--- a/src/xrt/drivers/solarxr/solarxr_ipc_socket.h
+++ b/src/xrt/drivers/solarxr/solarxr_ipc_socket.h
@@ -40,6 +40,9 @@
 solarxr_ipc_socket_connect(struct solarxr_ipc_socket *state, struct sockaddr_un addr);
 
 bool
+solarxr_ipc_socket_reconnect(struct solarxr_ipc_socket *state, struct sockaddr_un addr);
+
+bool
 solarxr_ipc_socket_wait_timeout(struct solarxr_ipc_socket *state, time_duration_ns timeout); // thread safe
 
 bool
diff --git a/src/xrt/drivers/solarxr/solarxr_device.c b/src/xrt/drivers/solarxr/solarxr_device.c
--- a/src/xrt/drivers/solarxr/solarxr_device.c
+++ b/src/xrt/drivers/solarxr/solarxr_device.c
@@ -629,7 +629,7 @@
 
 			//! @todo Maybe write a better way to silence the logs than passing in RAW log level?
 			const struct sockaddr_un path = solarxr_ipc_socket_find(U_LOGGING_RAW, "SlimeVRRpc");
-			if (solarxr_ipc_socket_connect(&device->socket, path)) {
+			if (solarxr_ipc_socket_reconnect(&device->socket, path)) {
 				lost_connection = false;
 			} else {
 				os_nanosleep(U_TIME_1S_IN_NS);
